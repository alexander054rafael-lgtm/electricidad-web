---
import { Save, Upload } from '@lucide/astro';

interface EditableBook {
  id: string; title: string; slug: string; author: string | null; category: string; level: string | null; resource_type: string; language: string; pages: number | null; is_published: boolean; description: string | null; tags: string[] | null; topics: string[] | null; badge: string | null; accent: string | null; allow_download: boolean; is_featured: boolean; cover_file_name: string | null; drive_file_name: string | null; cover_drive_file_id: string | null; drive_file_id: string | null;
}
interface Props { book?: EditableBook }
const { book } = Astro.props;
const editing = Boolean(book);
const categories = ['Electricidad Industrial', 'Automatización', 'PLC', 'Variadores de Frecuencia', 'Motores Eléctricos', 'Instrumentación', 'Electrónica', 'Seguridad Eléctrica'];
const FILE_BACKEND = import.meta.env.PUBLIC_LIBRARY_FILE_BACKEND ?? 'drive-browser';
---

<form class="book-form" data-book-form data-resource-id={book?.id} data-published={String(book?.is_published ?? false)} data-initial-book={book ? JSON.stringify({
  title: book.title,
  slug: book.slug,
  author: book.author ?? '',
  description: book.description ?? '',
  category: book.category,
  bookType: book.resource_type,
  level: book.level ?? 'Básico',
  language: book.language ?? 'Español',
  pages: book.pages ?? 1,
  tags: book.tags?.join(', ') ?? '',
  topics: book.topics?.join(', ') ?? '',
  badge: book.badge ?? '',
  accent: book.accent ?? '#16a34a',
  allowDownload: book.allow_download,
  isFeatured: book.is_featured,
}) : undefined} novalidate>
  {book && <input type="hidden" name="id" value={book.id} />}
  <div class="form-section">
    <div class="section-head"><span>01</span><div><h2>Información editorial</h2><p>Datos visibles en la Biblioteca Técnica.</p></div></div>
    <div class="grid">
      <label>Título*<input name="title" required minlength="3" value={book?.title ?? ''} /></label>
      <label>Slug*<input name="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" maxlength="180" value={book?.slug ?? ''} data-slug /><small>Se genera desde el título. Se añadirá automáticamente un identificador interno para evitar duplicados.</small></label>
      <label>Autor<input name="author" minlength="2" value={book?.author ?? ''} /></label>
      <label>Categoría*<select name="category" required><option value="">Selecciona</option>{categories.map(category => <option selected={book?.category === category}>{category}</option>)}</select></label>
      <label>Tipo*<select name="bookType" required><option selected={!book || book.resource_type === 'Libro'}>Libro</option><option selected={book?.resource_type === 'Manual'}>Manual</option><option selected={book?.resource_type === 'Guía'}>Guía</option><option selected={book?.resource_type === 'Catálogo'}>Catálogo</option><option selected={book?.resource_type === 'Ficha técnica'}>Ficha técnica</option><option selected={book?.resource_type === 'Norma'}>Norma</option><option selected={book?.resource_type === 'Documento'}>Documento</option></select></label>
      <label>Nivel*<select name="level" required><option selected={!book || book.level === 'Básico'}>Básico</option><option selected={book?.level === 'Intermedio'}>Intermedio</option><option selected={book?.level === 'Avanzado'}>Avanzado</option></select></label>
      <label>Idioma*<input name="language" value={book?.language ?? 'Español'} required /></label>
      <label>Páginas*<input name="pages" type="number" min="1" value={book?.pages ?? ''} required /></label>
    </div>
    <label>Descripción*<textarea name="description" rows="5" required minlength="20">{book?.description ?? ''}</textarea></label>
    <div class="grid">
      <label>Etiquetas<input name="tags" value={book?.tags?.join(', ') ?? ''} placeholder="PLC, Siemens, automatización" /><small>Separadas por comas.</small></label>
      <label>Temas incluidos<input name="topics" value={book?.topics?.join(', ') ?? ''} placeholder="Sensores, programación, diagnóstico" /><small>Separados por comas.</small></label>
      <label>Distintivo<select name="badge"><option value="">Sin distintivo</option><option selected={book?.badge === 'Recomendado'}>Recomendado</option><option selected={book?.badge === 'Popular'}>Popular</option><option selected={book?.badge === 'Nuevo'}>Nuevo</option></select></label>
      <label>Color de acento<input name="accent" type="color" value={book?.accent ?? '#16a34a'} /></label>
    </div>
  </div>
  <div class="form-section">
    <div class="section-head"><span>02</span><div><h2>Archivos en Google Drive</h2><p>{editing ? 'Solo selecciona un archivo si deseas reemplazar el actual.' : 'El PDF es obligatorio; la portada puede usar el fallback visual.'}</p></div></div>
    <div class="grid files">
      <div class="file-control"><label>Portada<input name="cover" type="file" accept="image/jpeg,image/png,image/webp" data-cover /><small>JPG, PNG o WebP · máximo 8 MB</small></label><div class="file-state" data-file-state="cover"><strong data-file-name>{book?.cover_file_name ?? 'Sin portada · se usará el fallback'}</strong><span data-file-size>{book?.cover_file_name ? 'Archivo actual' : 'Opcional'}</span><progress hidden></progress></div>{book?.cover_drive_file_id && <button type="button" class="remove-cover" data-remove-cover>Eliminar portada</button>}</div>
      <div class="file-control"><label>Documento PDF {editing ? '' : '*'}<input name="pdf" type="file" accept="application/pdf,.pdf" required={!editing} data-pdf /><small>PDF · máximo 100 MB</small></label><div class="file-state" data-file-state="pdf"><strong data-file-name>{book?.drive_file_name ?? 'Ningún PDF seleccionado'}</strong><span data-file-size>{book?.drive_file_name ? 'Archivo actual' : 'Obligatorio'}</span><progress hidden></progress></div></div>
    </div>
    <div class="preview" data-preview hidden={!book?.cover_drive_file_id}><img src={book?.cover_drive_file_id ? `/api/library/books/${book.id}/cover` : undefined} alt="Vista previa de portada" /></div>
    <p class="rights-notice">Sube únicamente material propio, de dominio público o que tengas autorización para distribuir.</p>
  </div>
  <div class="form-section">
    <div class="section-head"><span>03</span><div><h2>Publicación</h2><p>Controla cómo aparece este recurso dinámico.</p></div></div>
    <div class="grid options"><label class="check"><input name="allowDownload" type="checkbox" checked={book?.allow_download ?? false} /><span>Permitir descarga del PDF</span></label><label class="check"><input name="isFeatured" type="checkbox" checked={book?.is_featured ?? false} /><span>Marcar como destacado</span></label></div>
  </div>
  <div class="diagnostic-panel" data-diagnostic-panel hidden>
    <div class="diagnostic-header">
      <span class="diagnostic-title">Diagnóstico de subida</span>
      <span class="backend-badge" data-diag-backend>{FILE_BACKEND}</span>
    </div>
    <div class="diagnostic-details">
      <div class="diag-item"><span>Etapa:</span> <strong data-diag-stage>En espera</strong></div>
      <div class="diag-item"><span>Backend:</span> <strong>{FILE_BACKEND}</strong></div>
      <div class="diag-item"><span>Operación:</span> <strong data-diag-operation>—</strong></div>
      <div class="diag-item diag-full"><span>Último error:</span> <strong data-diag-error>Ninguno</strong></div>
    </div>
  </div>
  <div class="form-actions"><a href="/admin/biblioteca">Cancelar</a><p class="message" aria-live="assertive" data-message></p><button type="button" class="cancel-upload" data-cancel-upload hidden>Cancelar subida</button><button type="submit" class="draft-button" data-intent="draft"><Save size={18}/> Guardar borrador</button><button type="submit" data-intent="publish"><Upload size={18}/> Publicar</button></div>
</form>

<script>
  import { createBrowserClient } from '@supabase/ssr';
  import { formatUploadProgress, requestGoogleDriveAccessToken, uploadFileDirectToGoogleDrive, verifyBrowserDriveAccess } from '../../lib/google-drive/browser-upload';
  import { createR2DriveAdapter, type EditorialMetadata } from '../../lib/library/r2-drive-adapter';

  type UploadConfig = { pdfFolderId: string; coverFolderId: string; maxPdfBytes: number; maxCoverBytes: number; allowedPdfTypes: string[]; allowedCoverTypes: string[] };
  type Uploaded = { id: string; asset: 'pdf' | 'cover' };

  const FILE_BACKEND = import.meta.env.PUBLIC_LIBRARY_FILE_BACKEND ?? 'drive-browser';

  const sanitizeErrorMessage = (message: string): string => {
    if (!message) return 'Ocurrió un error desconocido.';
    let clean = String(message);
    clean = clean.replace(/https?:\/\/[^\s"'<>]+/gi, (fullUrl) => {
      try {
        const parsed = new URL(fullUrl);
        return `${parsed.origin}${parsed.pathname}`;
      } catch {
        return '[URL protegida]';
      }
    });
    clean = clean.replace(/(bearer\s+|token=)[a-zA-Z0-9_\-\.]{20,}/gi, '$1[TOKEN_PROTEGIDO]');
    clean = clean.replace(/(secret|key|refresh_token|access_token|client_secret)=[^&\s"']+/gi, '$1=[PROTEGIDO]');
    clean = clean.replace(/library\/[a-f0-9\-]+\/(pdf|cover)/gi, 'library/[KEY_PROTEGIDA]');
    return clean;
  };

  const mapStageName = (text: string): string => {
    const t = text.toLowerCase();
    if (t.includes('preparando')) return 'preparando subida';
    if (t.includes('subiendo pdf')) return 'subiendo PDF';
    if (t.includes('subiendo portada')) return 'subiendo portada';
    if (t.includes('validando')) return 'validando';
    if (t.includes('copiando') || t.includes('drive')) return 'copiando a Drive';
    if (t.includes('guardando') || t.includes('supabase') || t.includes('registrando')) return 'guardando en Supabase';
    if (t.includes('limpiando')) return 'limpiando temporales';
    return text;
  };

  const initializeBookForm = () => {
    const form = document.querySelector<HTMLFormElement>('[data-book-form]');
    if (!form || form.dataset.ready === 'true') return;
    form.dataset.ready = 'true';

    const message = form.querySelector<HTMLElement>('[data-message]');
    const cover = form.querySelector<HTMLInputElement>('[data-cover]');
    const pdf = form.querySelector<HTMLInputElement>('[data-pdf]');
    const preview = form.querySelector<HTMLElement>('[data-preview]');
    const titleInput = form.querySelector<HTMLInputElement>('input[name="title"]');
    const slugInput = form.querySelector<HTMLInputElement>('[data-slug]');
    const removeCoverButton = form.querySelector<HTMLButtonElement>('[data-remove-cover]');
    const cancelUploadButton = form.querySelector<HTMLButtonElement>('[data-cancel-upload]');
    const diagPanel = form.querySelector<HTMLElement>('[data-diagnostic-panel]');
    const diagStage = form.querySelector<HTMLElement>('[data-diag-stage]');
    const diagOperation = form.querySelector<HTMLElement>('[data-diag-operation]');
    const diagError = form.querySelector<HTMLElement>('[data-diag-error]');

    let removeCoverRequested = false;
    let isSubmitting = false;
    let previewUrl = '';
    let activeController: AbortController | undefined;
    let currentStage = 'en espera';
    let currentOpId: string | undefined;

    const slugify = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    if (!form.dataset.resourceId) {
      titleInput?.addEventListener('input', () => {
        if (slugInput && slugInput.dataset.manual !== 'true') slugInput.value = slugify(titleInput.value);
      });
    }
    slugInput?.addEventListener('input', () => {
      slugInput.dataset.manual = 'true';
      slugInput.setCustomValidity('');
    });

    // Remove error highlights on user input
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea').forEach(input => {
      input.addEventListener('input', () => input.classList.remove('has-error'));
      input.addEventListener('change', () => input.classList.remove('has-error'));
    });

    const updateDiagnostic = (stage: string, errorMsg?: string, operationId?: string) => {
      currentStage = stage;
      if (operationId) currentOpId = operationId;
      if (diagPanel) diagPanel.hidden = false;
      if (diagStage) diagStage.textContent = stage;
      if (diagOperation) diagOperation.textContent = currentOpId || '—';
      if (diagError) {
        const cleanErr = errorMsg ? sanitizeErrorMessage(errorMsg) : 'Ninguno';
        diagError.textContent = cleanErr;
        diagError.style.color = errorMsg ? '#dc2626' : 'var(--admin-text-muted)';
      }
    };

    const updateFileState = (asset: 'cover' | 'pdf', file?: File, status?: string) => {
      const state = form.querySelector<HTMLElement>(`[data-file-state="${asset}"]`);
      const name = state?.querySelector<HTMLElement>('[data-file-name]');
      const size = state?.querySelector<HTMLElement>('[data-file-size]');
      if (file && name && size) {
        name.textContent = file.name;
        size.textContent = `${(file.size / 1024 / 1024).toFixed(2)} MB · ${status ?? 'Listo para subir'}`;
      } else if (status && size) {
        size.textContent = status;
      }
    };

    const setStage = (text: string, asset?: 'cover' | 'pdf', state: 'working' | 'ok' | 'error' = 'working') => {
      const cleanText = sanitizeErrorMessage(text);
      if (message) {
        message.textContent = cleanText;
        message.dataset.state = state === 'working' ? '' : state;
      }
      form.querySelectorAll<HTMLProgressElement>('.file-state progress').forEach(progress => { progress.hidden = true; });
      if (asset) {
        const progress = form.querySelector<HTMLProgressElement>(`[data-file-state="${asset}"] progress`);
        if (progress) progress.hidden = false;
      }
      updateDiagnostic(mapStageName(text), state === 'error' ? cleanText : undefined);
    };

    const validateFormFields = (): { element: HTMLElement; message: string } | null => {
      form.querySelectorAll('.has-error').forEach(el => el.classList.remove('has-error'));

      const titleVal = titleInput?.value.trim() ?? '';
      if (!titleVal) {
        return { element: titleInput || form, message: 'Falta el título' };
      }

      const categorySelect = form.querySelector<HTMLSelectElement>('select[name="category"]');
      if (!categorySelect || !categorySelect.value.trim()) {
        return { element: categorySelect || form, message: 'Falta la categoría' };
      }

      const bookTypeSelect = form.querySelector<HTMLSelectElement>('select[name="bookType"]');
      if (!bookTypeSelect || !bookTypeSelect.value.trim()) {
        return { element: bookTypeSelect || form, message: 'Falta el tipo de recurso' };
      }

      const levelSelect = form.querySelector<HTMLSelectElement>('select[name="level"]');
      if (!levelSelect || !levelSelect.value.trim()) {
        return { element: levelSelect || form, message: 'Falta el nivel' };
      }

      const languageInput = form.querySelector<HTMLInputElement>('input[name="language"]');
      if (!languageInput || !languageInput.value.trim()) {
        return { element: languageInput || form, message: 'Falta el idioma' };
      }

      const pagesInput = form.querySelector<HTMLInputElement>('input[name="pages"]');
      const pagesRaw = pagesInput?.value.trim() ?? '';
      if (!pagesRaw) {
        return { element: pagesInput || form, message: 'Falta el número de páginas' };
      }
      const pagesNum = Number(pagesRaw);
      if (isNaN(pagesNum) || pagesNum <= 0) {
        return { element: pagesInput || form, message: 'El número de páginas debe ser mayor que 0' };
      }

      const descriptionTextarea = form.querySelector<HTMLTextAreaElement>('textarea[name="description"]');
      if (!descriptionTextarea || !descriptionTextarea.value.trim()) {
        return { element: descriptionTextarea || form, message: 'Falta la descripción' };
      }

      const pdfFile = pdf?.files?.[0];
      const editing = Boolean(form.dataset.resourceId);
      if (!editing && !pdfFile) {
        return { element: pdf || form, message: 'Selecciona un archivo PDF' };
      }
      if (pdfFile) {
        const isPdf = pdfFile.type === 'application/pdf' || pdfFile.name.toLowerCase().endsWith('.pdf');
        if (!isPdf) {
          return { element: pdf || form, message: 'El archivo seleccionado no es un PDF válido' };
        }
        const maxPdfBytes = 100 * 1024 * 1024;
        if (pdfFile.size > maxPdfBytes) {
          return { element: pdf || form, message: 'El PDF supera el tamaño máximo permitido' };
        }
      }

      const coverFile = cover?.files?.[0];
      if (coverFile) {
        const allowedCoverTypes = ['image/jpeg', 'image/png', 'image/webp'];
        const isCoverValid = allowedCoverTypes.includes(coverFile.type) || /\.(jpe?g|png|webp)$/i.test(coverFile.name);
        if (!isCoverValid) {
          return { element: cover || form, message: 'La portada debe ser JPG, PNG o WebP' };
        }
        const maxCoverBytes = 8 * 1024 * 1024;
        if (coverFile.size > maxCoverBytes) {
          return { element: cover || form, message: 'La portada supera el tamaño máximo permitido' };
        }
      }

      return null;
    };

    const applyFieldError = (result: { field?: string; error?: string }) => {
      if (result.field === 'slug' && slugInput) {
        slugInput.classList.add('has-error');
        slugInput.setCustomValidity(result.error ?? 'Slug inválido.');
        slugInput.reportValidity();
        slugInput.focus();
      }
    };

    const getConfig = async (): Promise<UploadConfig> => {
      const response = await fetch('/api/admin/library/upload-config');
      const result = await response.json();
      if (!response.ok) throw new Error(result.error ?? 'No se pudo preparar Google Drive.');
      return result as UploadConfig;
    };

    const metadataFrom = (data: FormData, intent: 'draft' | 'publish') => ({
      title: String(data.get('title') ?? ''),
      slug: String(data.get('slug') ?? ''),
      author: String(data.get('author') ?? ''),
      description: String(data.get('description') ?? ''),
      category: String(data.get('category') ?? ''),
      bookType: String(data.get('bookType') ?? ''),
      level: String(data.get('level') ?? ''),
      language: String(data.get('language') ?? ''),
      pages: Number(data.get('pages')),
      tags: String(data.get('tags') ?? ''),
      topics: String(data.get('topics') ?? ''),
      badge: String(data.get('badge') ?? '') || null,
      accent: String(data.get('accent') ?? ''),
      allowDownload: data.get('allowDownload') === 'on',
      isFeatured: data.get('isFeatured') === 'on',
      status: intent === 'publish' ? 'published' : 'draft',
    });

    const toEditorialMetadata = (data: FormData): EditorialMetadata => ({
      title: String(data.get('title') ?? '').trim(),
      slug: String(data.get('slug') ?? '').trim(),
      author: String(data.get('author') ?? '').trim() || null,
      description: String(data.get('description') ?? '').trim() || null,
      category: String(data.get('category') ?? '').trim(),
      resourceType: String(data.get('bookType') ?? '').trim(),
      level: String(data.get('level') ?? '').trim() || null,
      language: String(data.get('language') ?? 'Español').trim(),
      pages: data.get('pages') ? Number(data.get('pages')) : null,
      tags: String(data.get('tags') ?? '').split(',').map(t => t.trim()).filter(Boolean),
      topics: String(data.get('topics') ?? '').split(',').map(t => t.trim()).filter(Boolean),
      badge: String(data.get('badge') ?? '').trim() || null,
      accent: String(data.get('accent') ?? '#16a34a').trim(),
      allowDownload: data.get('allowDownload') === 'on',
      isFeatured: data.get('isFeatured') === 'on',
    });

    const cleanup = async (uploads: Uploaded[]) => {
      if (!uploads.length) return;
      updateDiagnostic('limpiando temporales');
      await fetch('/api/admin/library/cleanup-upload', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ files: uploads }),
      }).catch(() => undefined);
    };

    const upload = async (file: File, asset: 'pdf' | 'cover', config: UploadConfig, token: string, renew: () => Promise<string>, uploads: Uploaded[]) => {
      const valid = asset === 'pdf' ? config.allowedPdfTypes.includes(file.type) && file.size <= config.maxPdfBytes : config.allowedCoverTypes.includes(file.type) && file.size <= config.maxCoverBytes;
      if (!valid) throw new Error(asset === 'pdf' ? 'El PDF debe ser válido y no superar 100 MB.' : 'La portada debe ser JPG, PNG o WebP y no superar 8 MB.');
      const stageName = asset === 'pdf' ? 'subiendo PDF' : 'subiendo portada';
      setStage(asset === 'pdf' ? 'Subiendo PDF…' : 'Subiendo portada…', asset);
      updateDiagnostic(stageName);
      const result = await uploadFileDirectToGoogleDrive({ file, parentId: asset === 'pdf' ? config.pdfFolderId : config.coverFolderId, accessToken: token, renewAccessToken: renew, signal: activeController?.signal, onProgress: progress => { updateFileState(asset, file, formatUploadProgress(progress)); } });
      uploads.push({ id: result.id, asset });
      updateFileState(asset, file, 'Subida completada');
      return result;
    };

    cover?.addEventListener('change', () => {
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      const file = cover.files?.[0];
      const image = preview?.querySelector('img');
      if (file && image && preview) {
        removeCoverRequested = false;
        if (removeCoverButton) {
          removeCoverButton.textContent = 'Eliminar portada';
          removeCoverButton.dataset.active = 'false';
        }
        previewUrl = URL.createObjectURL(file);
        image.src = previewUrl;
        preview.hidden = false;
        updateFileState('cover', file);
      } else if (preview) {
        preview.hidden = true;
      }
    });

    pdf?.addEventListener('change', () => updateFileState('pdf', pdf.files?.[0]));

    removeCoverButton?.addEventListener('click', () => {
      removeCoverRequested = !removeCoverRequested;
      removeCoverButton.textContent = removeCoverRequested ? 'Portada marcada para eliminar' : 'Eliminar portada';
      removeCoverButton.dataset.active = removeCoverRequested ? 'true' : 'false';
      if (removeCoverRequested && cover) cover.value = '';
      if (removeCoverRequested && preview) preview.hidden = true;
    });

    cancelUploadButton?.addEventListener('click', () => {
      if (activeController) {
        activeController.abort();
        setStage('Cancelando subida…', undefined, 'error');
        updateDiagnostic('subida cancelada', 'Subida cancelada por el usuario.');
      }
    });

    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (isSubmitting) return;

      slugInput?.setCustomValidity('');

      // ── Step 1: Mandatory Field Validation ──
      const valError = validateFormFields();
      if (valError) {
        valError.element.classList.add('has-error');
        setStage(valError.message, undefined, 'error');
        updateDiagnostic('validación local', valError.message);
        valError.element.scrollIntoView({ behavior: 'smooth', block: 'center' });
        if ('focus' in valError.element && typeof valError.element.focus === 'function') {
          valError.element.focus({ preventScroll: true });
        }
        return;
      }

      if (!form.checkValidity()) {
        const firstInvalid = form.querySelector<HTMLElement>(':invalid');
        if (firstInvalid) {
          firstInvalid.classList.add('has-error');
          firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
          if ('focus' in firstInvalid && typeof firstInvalid.focus === 'function') {
            firstInvalid.focus({ preventScroll: true });
          }
        }
        form.reportValidity();
        return;
      }

      const submitter = event.submitter as HTMLButtonElement | null;
      const intent = (submitter?.dataset.intent as 'draft' | 'publish') || 'publish';
      const resourceId = form.dataset.resourceId;
      const formData = new FormData(form);
      const coverFile = cover?.files?.[0];
      const pdfFile = pdf?.files?.[0];

      // ── Branch 1: R2 + Drive Worker flow (Phase 4, new resources) ──
      if (FILE_BACKEND === 'r2-drive' && !resourceId) {
        if (!pdfFile) {
          setStage('Selecciona un archivo PDF', undefined, 'error');
          if (pdf) {
            pdf.classList.add('has-error');
            pdf.focus({ preventScroll: true });
          }
          return;
        }

        isSubmitting = true;
        activeController = new AbortController();
        if (cancelUploadButton) cancelUploadButton.hidden = false;
        form.querySelectorAll<HTMLButtonElement>('button[type="submit"]').forEach(btn => { btn.disabled = true; });
        updateDiagnostic('preparando subida');

        try {
          const url = import.meta.env.PUBLIC_SUPABASE_URL;
          const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
          if (!url || !key) throw new Error('Supabase no está configurado en el navegador.');
          const supabase = createBrowserClient(url, key);
          const adapter = createR2DriveAdapter(supabase);
          const metadata = toEditorialMetadata(formData);

          const result = await adapter.uploadAndSave(
            { pdf: pdfFile, cover: coverFile },
            metadata,
            intent,
            (stageText, percent) => {
              const mapped = mapStageName(stageText);
              setStage(`${stageText} (${percent}%)`);
              updateDiagnostic(mapped);
            },
            activeController.signal,
          );

          if (result.operationId) currentOpId = result.operationId;
          updateDiagnostic('completado', undefined, result.operationId);
          setStage(result.message || 'Recurso creado exitosamente.', undefined, 'ok');
          window.location.href = '/admin/biblioteca';
        } catch (error) {
          if (activeController?.signal.aborted) {
            setStage('Subida cancelada.', undefined, 'error');
            updateDiagnostic('cancelado', 'Subida cancelada por el usuario.');
          } else {
            const err = error as { field?: string; error?: string; message?: string; code?: string; operationId?: string };
            if (err.field) applyFieldError(err);
            const safeCode = err.code ? ` [Código: ${err.code}]` : '';
            const safeMsg = sanitizeErrorMessage(err.message || err.error || 'Error al subir el recurso.');
            setStage(`[${currentStage}] ${safeMsg}${safeCode}`, undefined, 'error');
            updateDiagnostic(currentStage, `${safeMsg}${safeCode}`, err.operationId || currentOpId);
          }
        } finally {
          isSubmitting = false;
          if (cancelUploadButton) cancelUploadButton.hidden = true;
          form.querySelectorAll<HTMLButtonElement>('button[type="submit"]').forEach(btn => { btn.disabled = false; });
        }
        return;
      }

      // ── Branch 2: Metadata-only update (Editing existing resource without new files) ──
      const hasNewPdf = pdfFile instanceof File && pdfFile.size > 0;
      const hasNewCover = coverFile instanceof File && coverFile.size > 0;
      const requiresFileUpload = hasNewPdf || hasNewCover;

      if (resourceId && !requiresFileUpload) {
        isSubmitting = true;
        activeController = new AbortController();
        form.querySelectorAll<HTMLButtonElement>('button[type="submit"]').forEach(btn => { btn.disabled = true; });

        try {
          setStage('Guardando cambios…');
          updateDiagnostic('actualizando metadatos');

          let rawInitial: Record<string, any> = {};
          if (form.dataset.initialBook) {
            try { rawInitial = JSON.parse(form.dataset.initialBook); } catch {}
          }

          const initial: Record<string, unknown> = {
            title: String(rawInitial.title ?? '').trim(),
            slug: String(rawInitial.slug ?? '').trim(),
            author: String(rawInitial.author ?? '').trim(),
            description: String(rawInitial.description ?? '').trim(),
            category: String(rawInitial.category ?? '').trim(),
            bookType: String(rawInitial.bookType ?? rawInitial.resource_type ?? '').trim(),
            level: String(rawInitial.level ?? 'Básico').trim(),
            language: String(rawInitial.language ?? 'Español').trim(),
            pages: rawInitial.pages ? Number(rawInitial.pages) : 0,
            tags: Array.isArray(rawInitial.tags) ? rawInitial.tags.join(', ') : String(rawInitial.tags ?? '').trim(),
            topics: Array.isArray(rawInitial.topics) ? rawInitial.topics.join(', ') : String(rawInitial.topics ?? '').trim(),
            badge: (rawInitial.badge ?? '') ? String(rawInitial.badge).trim() : null,
            accent: String(rawInitial.accent ?? '#16a34a').trim(),
            allowDownload: Boolean(rawInitial.allowDownload ?? rawInitial.allow_download ?? false),
            isFeatured: Boolean(rawInitial.isFeatured ?? rawInitial.is_featured ?? false),
          };

          const current: Record<string, unknown> = {
            title: String(formData.get('title') ?? '').trim(),
            slug: String(formData.get('slug') ?? '').trim(),
            author: String(formData.get('author') ?? '').trim(),
            description: String(formData.get('description') ?? '').trim(),
            category: String(formData.get('category') ?? '').trim(),
            bookType: String(formData.get('bookType') ?? '').trim(),
            level: String(formData.get('level') ?? '').trim(),
            language: String(formData.get('language') ?? '').trim(),
            pages: Number(formData.get('pages')),
            tags: String(formData.get('tags') ?? '').trim(),
            topics: String(formData.get('topics') ?? '').trim(),
            badge: String(formData.get('badge') ?? '').trim() || null,
            accent: String(formData.get('accent') ?? '').trim(),
            allowDownload: formData.get('allowDownload') === 'on',
            isFeatured: formData.get('isFeatured') === 'on',
          };

          const patchPayload: Record<string, unknown> = {};
          for (const key of Object.keys(current)) {
            if (current[key] !== initial[key]) {
              patchPayload[key] = current[key];
            }
          }

          if (removeCoverRequested) {
            patchPayload.removeCover = true;
          }


          if (Object.keys(patchPayload).length === 0) {
            setStage('No hay cambios que guardar.', undefined, 'ok');
            updateDiagnostic('completado');
            window.location.href = '/admin/biblioteca';
            return;
          }

          const response = await fetch(`/api/admin/library/${resourceId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(patchPayload),
            signal: activeController.signal,
          });
          const result = await response.json();
          if (!response.ok || !result.ok) {
            applyFieldError(result);
            const errCode = result.code ? ` [Código: ${result.code}]` : '';
            throw new Error(`${result.error ?? 'No se pudieron guardar los cambios.'}${errCode}`);
          }
          updateDiagnostic('completado');
          setStage('Recurso actualizado con éxito.', undefined, 'ok');
          window.location.href = '/admin/biblioteca';
        } catch (error) {
          if (activeController?.signal.aborted) {
            setStage('Operación cancelada.', undefined, 'error');
            updateDiagnostic('cancelado', 'Operación cancelada por el usuario.');
          } else {
            const errObj = error as { message?: string; code?: string; operationId?: string };
            const safeCode = errObj.code ? ` [Código: ${errObj.code}]` : '';
            const safeMsg = sanitizeErrorMessage(errObj.message || 'Ocurrió un error al actualizar los metadatos.');
            setStage(`[${currentStage}] ${safeMsg}${safeCode}`, undefined, 'error');
            updateDiagnostic(currentStage, `${safeMsg}${safeCode}`, errObj.operationId || currentOpId);
          }
        } finally {
          isSubmitting = false;
          form.querySelectorAll<HTMLButtonElement>('button[type="submit"]').forEach(btn => { btn.disabled = false; });
        }
        return;
      }

      // ── Branch 3: Browser Google Drive direct flow / Edition with new files ──
      isSubmitting = true;
      activeController = new AbortController();
      if (cancelUploadButton) cancelUploadButton.hidden = false;
      form.querySelectorAll<HTMLButtonElement>('button[type="submit"]').forEach(btn => { btn.disabled = true; });
      const uploads: Uploaded[] = [];

      try {
        setStage('Verificando acceso a Google Drive…');
        updateDiagnostic('preparando subida');
        const config = await getConfig();
        let token = await requestGoogleDriveAccessToken();
        await verifyBrowserDriveAccess([config.pdfFolderId, config.coverFolderId], token, activeController?.signal);
        const renewToken = async () => { token = await requestGoogleDriveAccessToken('consent'); return token; };

        let pdfResult: Uploaded | undefined;
        let coverResult: Uploaded | undefined;

        if (hasNewPdf) {
          const res = await upload(pdfFile!, 'pdf', config, token, renewToken, uploads);
          pdfResult = { id: res.id, asset: 'pdf' };
        }
        if (hasNewCover) {
          const res = await upload(coverFile!, 'cover', config, token, renewToken, uploads);
          coverResult = { id: res.id, asset: 'cover' };
        }

        if (resourceId) {
          setStage('Guardando cambios…');
          updateDiagnostic('guardando en Supabase');
          const body = {
            ...metadataFrom(formData, intent),
            ...(pdfResult ? { driveFileId: pdfResult.id } : {}),
            ...(coverResult ? { coverDriveFileId: coverResult.id } : {}),
            ...(removeCoverRequested ? { removeCover: true } : {}),
          };
          const response = await fetch(`/api/admin/library/${resourceId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
            signal: activeController.signal,
          });
          const result = await response.json();
          if (!response.ok || !result.ok) {
            applyFieldError(result);
            const errCode = result.code ? ` [Código: ${result.code}]` : '';
            throw new Error(`${result.error ?? 'No se pudieron guardar los cambios.'}${errCode}`);
          }
          updateDiagnostic('completado');
          setStage('Recurso actualizado con éxito.', undefined, 'ok');
          window.location.href = '/admin/biblioteca';
        } else {
          setStage('Registrando recurso en la biblioteca…');
          updateDiagnostic('guardando en Supabase');
          if (!pdfResult) throw new Error('El PDF es obligatorio para crear un recurso.');
          const body = {
            ...metadataFrom(formData, intent),
            driveFileId: pdfResult.id,
            ...(coverResult ? { coverDriveFileId: coverResult.id } : {}),
          };
          const response = await fetch('/api/admin/library/complete-upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
            signal: activeController.signal,
          });
          const result = await response.json();
          if (!response.ok || !result.ok) {
            applyFieldError(result);
            const errCode = result.code ? ` [Código: ${result.code}]` : '';
            throw new Error(`${result.error ?? 'No se pudo completar la creación del recurso.'}${errCode}`);
          }
          updateDiagnostic('completado');
          setStage('Recurso creado con éxito.', undefined, 'ok');
          window.location.href = '/admin/biblioteca';
        }
      } catch (error) {
        if (activeController?.signal.aborted) {
          setStage('Subida cancelada.', undefined, 'error');
          updateDiagnostic('cancelado', 'Subida cancelada por el usuario.');
        } else {
          const errObj = error as { message?: string; code?: string; operationId?: string };
          const safeCode = errObj.code ? ` [Código: ${errObj.code}]` : '';
          const safeMsg = sanitizeErrorMessage(errObj.message || 'Ocurrió un error inesperado al subir.');
          setStage(`[${currentStage}] ${safeMsg}${safeCode}`, undefined, 'error');
          updateDiagnostic(currentStage, `${safeMsg}${safeCode}`, errObj.operationId || currentOpId);
        }
        await cleanup(uploads);
      } finally {
        isSubmitting = false;
        if (cancelUploadButton) cancelUploadButton.hidden = true;
        form.querySelectorAll<HTMLButtonElement>('button[type="submit"]').forEach(btn => { btn.disabled = false; });
      }
    });
  };

  initializeBookForm();
  document.addEventListener('astro:page-load', initializeBookForm);
</script>

