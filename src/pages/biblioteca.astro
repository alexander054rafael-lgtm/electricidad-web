---
import Layout from '../layouts/Layout.astro';
import Header from '../components/landing/Header.astro';
import Footer from '../components/landing/Footer.astro';
import LibraryHero from '../components/library/LibraryHero.astro';
import LibrarySearch from '../components/library/LibrarySearch.astro';
import LibraryFilters from '../components/library/LibraryFilters.astro';
import BookGrid from '../components/library/BookGrid.astro';
import { getPublishedDatabaseBooks, mergeLibraryResources } from '../lib/library/books';

export const prerender = false;

const { books: dynamicResources, error: dynamicError } = await getPublishedDatabaseBooks(Astro.locals.supabase);
if (dynamicError) console.warn('[biblioteca] Algunos recursos dinámicos no pudieron cargarse.');
const books = mergeLibraryResources(dynamicResources);
---
<Layout title="Biblioteca Técnica | InduTech Academy" description="Libros, manuales y guías técnicas de electricidad industrial y automatización."><Header /><main><LibraryHero /><section class="library-page"><div class="container">{dynamicError && <p class="library-notice" role="status">Algunos recursos dinámicos no pudieron cargarse.</p>}<LibrarySearch /><LibraryFilters /><BookGrid books={books} /></div></section></main><Footer /></Layout>
<style>.library-page{padding:clamp(3rem,7vw,5rem) 0 6rem;background:var(--color-gray-50)}.library-notice{margin:0 0 1rem;padding:.65rem .8rem;border:1px solid #fde68a;border-radius:9px;background:#fffbeb;color:#854d0e;font-size:.78rem}</style>
